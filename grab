#!/usr/bin/env python3
import argparse
import os
import shutil
import sys
import time
from pathlib import Path

DEFAULT_CONFIG_DIR = Path.home() / ".config" / "grab"
DEFAULT_CONFIG_FILE = DEFAULT_CONFIG_DIR / "grab_config"

DEFAULT_CONFIG = """\
# grab configuration
# Default time limit in minutes. Set to -1 to disable.
time=3
# Downloads directory path (~ is expanded)
downloads_dir=~/Downloads
"""


def get_file_arrival_time(path: Path) -> float:
    st = path.stat()
    candidates = [st.st_ctime, st.st_mtime]
    if hasattr(st, "st_birthtime"):
        candidates.append(st.st_birthtime)
    return max(candidates)


def ensure_config(config_path: Path) -> None:
    """create the default config file if it doesn't exist"""
    if config_path.exists():
        return

    config_path.parent.mkdir(parents=True, exist_ok=True)
    config_path.write_text(DEFAULT_CONFIG)


def load_config(config_path: Path) -> dict:
    """read and validate config file"""
    if not config_path.is_file():
        print(f"Error: Config file {config_path} not found.", file=sys.stderr)
        sys.exit(1)

    if not os.access(config_path, os.R_OK):
        print(f"Error: Config file {config_path} is not readable.", file=sys.stderr)
        sys.exit(1)

    config = {}
    with open(config_path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, _, value = line.partition("=")
                config[key.strip()] = value.strip()

    if "time" not in config or "downloads_dir" not in config:
        print(
            f"Error: Config file {config_path} is malformed. "
            "It must contain 'time' and 'downloads_dir' keys.",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        config["time"] = int(config["time"])
    except ValueError:
        print("Error: 'time' value in config must be an integer.", file=sys.stderr)
        sys.exit(1)

    config["downloads_dir"] = Path(config["downloads_dir"]).expanduser()

    return config


def find_recent_files(downloads_dir: Path, time_limit_minutes: int) -> list:
    """
    Find files in downloads_dir that arrived within the time limit.
    - time_limit_minutes -1 returns all files
    - sorted newest-first by arrival time
    """
    now = time.time()
    files = []

    for entry in downloads_dir.iterdir():
        if not entry.is_file():
            continue
        arrival = get_file_arrival_time(entry)
        if time_limit_minutes == -1 or (now - arrival) <= time_limit_minutes * 60:
            files.append((arrival, entry))

    files.sort(key=lambda x: x[0], reverse=True)

    return [f for _, f in files]


def confirm(prompt: str) -> bool:
    try:
        response = input(f"{prompt} [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return response in ("y", "yes")


def grab(args=None) -> int:
    config_path = DEFAULT_CONFIG_FILE
    ensure_config(config_path)
    config = load_config(config_path)

    time_limit_minutes = config["time"]
    downloads_dir = config["downloads_dir"]

    parser = argparse.ArgumentParser(
        prog="grab",
        description="Move or delete recent files from your Downloads directory.",
    )

    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        dest="grab_all",
        help="Grab all matching files (default: newest file only)",
    )

    parser.add_argument(
        "-x",
        "--delete",
        action="store_true",
        help="Delete files instead of moving them",
    )

    parser.add_argument(
        "-l",
        "--log",
        action="store_true",
        help="Print each filename as it is processed",
    )

    parser.add_argument(
        "-p",
        "--preview",
        action="store_true",
        help="List matching files without moving or deleting",
    )

    parser.add_argument(
        "-t",
        "--time",
        type=int,
        default=None,
        dest="time_override",
        help="Override time limit in minutes (-1 for no limit)",
    )

    parser.add_argument(
        "destination",
        nargs="?",
        default=".",
        help="Destination directory (default: current directory)",
    )

    parsed = parser.parse_args(args)

    if parsed.time_override is not None:
        time_limit_minutes = parsed.time_override

    if time_limit_minutes < -1 or time_limit_minutes == 0:
        print("Error: Time limit must be a positive integer or -1.", file=sys.stderr)
        return 1

    # for safety don't allow deleting everything
    if parsed.grab_all and time_limit_minutes == -1 and parsed.delete:
        print(
            "Error: Cannot delete all files with no time limit. "
            "That would wipe your entire Downloads folder.",
            file=sys.stderr,
        )
        return 1

    if not downloads_dir.is_dir():
        print(
            f"Error: Downloads directory '{downloads_dir}' does not exist.",
            file=sys.stderr,
        )
        return 1

    destination = Path(parsed.destination).resolve()
    if not parsed.delete and not parsed.preview:
        if not destination.is_dir():
            print(
                f"Error: Destination '{destination}' does not exist.", file=sys.stderr
            )
            return 1
        if not os.access(destination, os.W_OK):
            print(f"Error: No write permission for '{destination}'.", file=sys.stderr)
            return 1

    # find files
    files = find_recent_files(downloads_dir, time_limit_minutes)

    if not files:
        if time_limit_minutes == -1:
            print("No files found in Downloads directory.")
        else:
            print(
                f"No recent files found within the last {time_limit_minutes} minute(s)."
            )
        return 0

    # preview mode
    if parsed.preview:
        for f in files:
            print(f.name)
        print(f"\n{len(files)} file(s) found.")
        return 0

    targets = files if parsed.grab_all else [files[0]]
    display_dest = (
        "current directory" if parsed.destination == "." else str(destination)
    )
    action_past = "Deleted" if parsed.delete else "Moved"

    # confirmation for bulk operations
    if len(targets) > 1 and (parsed.delete or parsed.grab_all):
        verb = "delete" if parsed.delete else f"move to {display_dest}"
        print(f"About to {verb} {len(targets)} file(s):")
        for t in targets[:10]:
            print(f"  {t.name}")
        if len(targets) > 10:
            print(f"  ... and {len(targets) - 10} more")
        if not confirm("Proceed?"):
            print("Operation aborted.")
            return 1

    count = 0
    for f in targets:
        try:
            if parsed.delete:
                f.unlink()
            else:
                dest_path = destination / f.name
                # handle name collisions
                if dest_path.exists():
                    stem, suffix = f.stem, f.suffix
                    i = 1
                    while dest_path.exists():
                        dest_path = destination / f"{stem}_{i}{suffix}"
                        i += 1
                shutil.move(str(f), str(dest_path))
            count += 1
            if parsed.log:
                print(f"{action_past} {f.name}")
        except OSError as e:
            print(f"Error processing {f.name}: {e}", file=sys.stderr)

    if count == 0:
        print("No files were processed.")
    elif parsed.delete:
        print(f"{action_past} {count} file(s).")
    elif count == 1:
        print(f"{action_past} {targets[0].name} to {display_dest}.")
    else:
        print(f"{action_past} {count} file(s) to {display_dest}.")
    return 0


if __name__ == "__main__":
    sys.exit(grab())
